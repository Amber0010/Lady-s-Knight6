    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "\u201CGood work Sir Roly, we have successfully recovered the crown.\u201D\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.data[1].text
      value: "\u201CUndamaged to boot.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "\u201CYes, how truly fortuitous.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.data[3].text
      value: "\u201CWe will still be having a talk about your dereliction of duty.\u201D\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
      propertyPath: lines.Array.data[4].text
      value: "\u201C. . . Yes, milady.\u201D\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7637081734244307681, guid: 1bcdbca270d815c488ca5936c66bf65f, type: 3}
